{
  "id": "evidence_verifier",
  "name": "Evidence Verifier",
  "version": "1.0.0",
  "description": "SHA-256 tamper evidence: hashes content into chained integrity records (store) and verifies them, failing on tampered content (verify).",
  "author": "Cerebrum Factory",
  "layer": 3,
  "tags": [
    "estate",
    "private_estate_operations",
    "steward"
  ],
  "inputs": [
    {
      "name": "action",
      "type": "string",
      "required": false,
      "default": "store",
      "options": [
        "store",
        "verify",
        "list"
      ],
      "description": "store | verify | list"
    },
    {
      "name": "content",
      "type": "json",
      "required": true,
      "description": "Content to hash (store) or verify"
    },
    {
      "name": "record_id",
      "type": "string",
      "required": false,
      "description": "Integrity record id for verify"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Capability result"
    }
  ],
  "permissions": {
    "blocks": [],
    "filesystem": false,
    "imports": [],
    "network": false
  },
  "publisher_id": "cerebrum_platform",
  "requires": [],
  "execution": {
    "type": "python",
    "entrypoint": "block.py"
  }
}
