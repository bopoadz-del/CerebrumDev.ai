      "validation",
      "document_engine",
      "knowledge",
      "vector_search",
      "formula_executor",
      "audit",
      "notification",
      "workflow",
      "event_bus",
      "queue",
      "team",
      "dashboard",
      "analytics",
      "spec_analyzer",
      "recommendation_template",
      "capture"
    ]
  },
  "capabilities": [
    "estate_registry",
    "estate_maintenance",
    "house_manual_sop",
    "vendor_budget",
    "preventive_maintenance",
    "staff_scheduling",
    "principal_dashboard",
