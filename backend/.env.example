CEREBRUM_API_URL=http://localhost:8000
# Copy from your vault (Bitwarden/1Password). No real keys in the repo.
CEREBRUM_API_KEY=

# Configurator backend API key. Required in production; optional in dev.
CEREBRUM_DEV_API_KEY=

# LLM provider: kimi (default) | moonshot (alias for kimi)
#             | claude | anthropic (alias for claude)
# If unset, auto-detected from configured credentials. Kimi WINS whenever Kimi
# credentials exist, even if Claude credentials also exist — adding a second
# key must never move your traffic, or your bill, onto another provider.
# Claude is auto-selected only when it is the sole provider configured.
LLM_PROVIDER=

# Kimi / Moonshot AI - OpenAI-compatible. THE DEFAULT WORKHORSE.
# When this key is set, the product architect drafts with the LLM and the
# coding agent writes GENERATE handlers — no second flag required.
# Explicit ARCHITECT_LLM_DRAFTING_ENABLED=0 still forces templates.
CEREBRUM_LLM_API_KEY=
CEREBRUM_LLM_BASE_URL=https://api.moonshot.cn/v1
CEREBRUM_LLM_MODEL=moonshot-v1-8k

# Claude / Anthropic - native Messages API (NOT OpenAI-compatible: x-api-key,
# anthropic-version header, top-level system parameter, content blocks).
# Set LLM_PROVIDER=claude to use it. Asking for Claude without a key is a loud
# error — it never silently falls back to Kimi.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5-20251001

# Chat (conversational) and Factory (architect/generation) paths can use
# different Kimi models. Defaults follow CEREBRUM_LLM_MODEL if unset.
# CEREBRUM_CHAT_LLM_MODEL=moonshot-v1-8k
# CEREBRUM_FACTORY_LLM_MODEL=kimi-k2.7-code   # code default

# Fallback models when the primary model fails. Chat falls back to another
# chat-capable Kimi model; Factory falls back to another code-capable model.
# CEREBRUM_CHAT_LLM_FALLBACK_MODEL=moonshot-v1-8k
# CEREBRUM_FACTORY_LLM_FALLBACK_MODEL=kimi-k2.5-code
# CEREBRUM_LLM_FALLBACK_MODEL=kimi-k2.5-code   # runtime engine

# --- Coder cross-provider fallback leg (OpenRouter) ---------------------------
# The fallback above swaps the MODEL but keeps the same endpoint and key, so it
# cannot help with the failure that actually happens most: an out-of-credit or
# rate-limited Moonshot account fails both Kimi models identically. This leg is
# a whole second endpoint, tried only after the primary vendor's own fallback
# has also failed.
#
# Order on failure: primary -> vendor fallback -> this leg -> honest CoderError.
# The model that ANSWERS is what gets stamped into generated modules as
# CODER_MODEL, so a GLM-written handler says GLM.
#
# Setting the key is what arms the leg; there is no path where it turns itself
# on. Leaving it unset keeps the previous behaviour exactly.
# OPENROUTER_API_KEY=
#
# Defaults to minimax/minimax-m3:free — zero-priced, 1M context. The ':free'
# suffix is load-bearing: plain minimax/minimax-m3 is the paid tier
# ($0.30/$1.20 per Mtok). A non-free slug is REFUSED unless
# FACTORY_LLM_FALLBACK_ALLOW_PAID=1 says the bill is intended.
# Was z-ai/glm-5.2:free until measured 2026-08-27 (GLM 1/4, minimax-m3 3/4).
# FACTORY_LLM_FALLBACK_MODEL=minimax/minimax-m3:free
# FACTORY_LLM_FALLBACK_ALLOW_PAID=0
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# Turn the leg off entirely without removing the key:
# FACTORY_LLM_FALLBACK_PROVIDER=none

STORAGE_PATH=./storage
CHROMA_PERSIST_DIR=./storage/chroma

# --- Nightly in-process backups (core/backup_scheduler.py) --------------------
# Runs inside the web service: Render cron jobs cannot mount persistent disks,
# so this process is the only one that can snapshot STORAGE_PATH. Archives land
# in STORAGE_PATH/backups (override with BACKUP_DIR); last run's report is in
# last_backup.json there and surfaced at /ready under details.last_backup.
BACKUP_SCHEDULE_ENABLED=1
BACKUP_UTC_HOUR=3
BACKUP_KEEP=14
# BACKUP_DIR=

# --- User accounts (P0 trust layer) ------------------------------------------
# Default: sqlite file at STORAGE_PATH/accounts.db. Render's default filesystem
# is EPHEMERAL — for real users, either:
#   a) attach a persistent disk and set ACCOUNTS_DB_PATH=/var/lib/cerebrum/accounts.db
#   b) provision managed Postgres and set ACCOUNTS_DATABASE_URL (recommended)
# ACCOUNTS_DB_PATH=
# ACCOUNTS_DATABASE_URL=postgresql://user:pass@host:5432/cerebrum_accounts
# Block unverified accounts from credential-gated routes (default: advisory off)
ACCOUNTS_REQUIRE_VERIFIED_EMAIL=false
# Rate limits for public auth endpoints (per client IP, in-memory)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_S=600
# Email provider. Resend API is the easiest reliable path; SMTP is the generic
# fallback. With neither configured, register/forgot-password return dev tokens
# in the API response (honest dev mode — no email is sent).
# RESEND_API_KEY=re_...
# RESEND_FROM=no-reply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com

# --- Billing & trials (P3) ---------------------------------------------------
# Length of the free trial for new accounts, in days (no card upfront).
TRIAL_DAYS=3
# Enforce entitlement: expired trials / canceled subscriptions get 402 on paid
# actions (session creation, factory runs). Default OFF — flip on at launch.
# Accounts created before P3 have no billing fields and are NOT entitled when
# this is on; grant them via accounts_store.set_subscription(account_id, "active").
BILLING_ENFORCEMENT=false

# --- Stripe (P3 billing) -----------------------------------------------------
# Recurring subscription checkout + webhook. With these unset, /v1/billing/
# checkout and /portal return 503 stripe_not_configured and the webhook is inert.
# STRIPE_SECRET_KEY=sk_test_...
# Recurring Price created in the Stripe dashboard (this is where the amount,
# currency, and monthly/yearly interval live — change them there, not in code).
# STRIPE_PRICE_ID=price_...
# Signing secret of the webhook endpoint pointing at {API base}/v1/billing/webhook
# (Stripe dashboard → Developers → Webhooks). Events to subscribe:
#   checkout.session.completed, customer.subscription.created,
#   customer.subscription.updated, customer.subscription.deleted,
#   invoice.payment_failed
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Thin runtime (P4) -------------------------------------------------------
# Headless coding-agent loop: python -m runtime <change-request.json> <product_root>
# Runs against a product workspace containing product-dna/ (checksums verified
# before any model call). Provider keys are the same vars as above
# (CEREBRUM_LLM_* for cloud_api; Kimi is the only supported provider).
# ENGINE_PROFILE=cloud_api          # cloud_api only
# GATES_COMMANDS=pytest             # comma-separated, run in the product workspace
# AGENT_MAX_TURNS=12                # implement-loop bound; exceeded = structured halt
# PROTOCOLS_PATH=docs/CODINGPROTOCOLS.md
# RUNTIME_REPORT_DIR=runtime-runs/<request_id>

# Document parsing (local-only; disabled by default on Render)
MARKER_ENABLED=false  # set true only if marker-pdf is installed locally

# RAG source acquisition preview limits
RAG_ACQUISITION_MAX_BYTES=26214400
RAG_ACQUISITION_MAX_REDIRECTS=3
RAG_ACQUISITION_CONNECT_TIMEOUT_SECONDS=10
RAG_ACQUISITION_READ_TIMEOUT_SECONDS=30
RAG_PARSE_MAX_PAGES=250
RAG_PARSE_MAX_CHARACTERS=200000
RAG_PARSE_PREVIEW_CHARACTERS=10000

# Canonical document and deterministic chunking
RAG_CANONICAL_NORMALIZATION_VERSION=canonical-text-v1
RAG_CHUNKING_ALGORITHM=structural-character
RAG_CHUNKING_VERSION=structural-character-v1
RAG_CHUNK_TARGET_CHARACTERS=3200
RAG_CHUNK_MAX_CHARACTERS=4000
RAG_CHUNK_OVERLAP_CHARACTERS=400
RAG_CHUNK_MIN_CHARACTERS=200
RAG_CANONICAL_PREVIEW_CHARACTERS=10000

# Auto-deploy Git auth.
# DEPLOY_REPO_URL is the dedicated target repository for git-push deploys.
# It must never be the CerebrumDev.ai repository itself. Git-push deploy is
# disabled when this variable is unset.
GITHUB_TOKEN=
DEPLOY_REPO_URL=

# Platform packager (P4): path to local Cerebrum-Blocks repo for kit resolution.
# Falls back to a sibling directory if not set.
CEREBRUM_BLOCKS_ROOT=

# Git repository used by the platform Dockerfile to clone the Cerebrum-Blocks runtime.
# For a private repo, set GITHUB_TOKEN (fine-grained token with Contents:read only).
CEREBRUM_BLOCKS_REPO=https://github.com/bopoadz-del/Cerebrum-Blocks.git
# GITHUB_TOKEN=ghp_...

# Embedding dry-run configuration
RAG_EMBEDDING_DEFAULT_PROVIDER=local_feature_hash_v1
RAG_EMBEDDING_DIMENSIONS=384
RAG_EMBEDDING_BATCH_SIZE=64
RAG_EMBEDDING_VECTOR_PRECISION=8
RAG_EMBEDDING_NORM_TOLERANCE=0.00001

# Vector indexing dry-run configuration
RAG_VECTOR_DEFAULT_ADAPTER=local_flat_json_v1
RAG_VECTOR_INDEX_MANIFEST_VERSION=vector-index-manifest-v1
RAG_VECTOR_RECORD_PRECISION=8
RAG_VECTOR_INDEX_MAX_RECORDS=10000
RAG_VECTOR_INDEX_INCLUDE_VECTORS_DEFAULT=false

# Multi-user Google Drive connector (factory + generated platforms)
# Generate DATA_ENCRYPTION_KEY with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/sessions/drive/callback
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173
DATA_ENCRYPTION_KEY=

# Resident Engineer (Milestone 2+) — default OFF
RESIDENT_ENGINEER_ENABLED=false

# Change-request loop (Milestone 3) — paperwork / dry-run only; default OFF
CHANGE_REQUEST_INTAKE_ENABLED=false
RESIDENT_EMIT_CHANGE_REQUESTS=false
# Optional product Ed25519 private key (base64). Never a GitHub/Render credential.
# PRODUCT_CHANGE_REQUEST_SIGNING_KEY=

# Build Mode workbench (Milestone 4) — candidate build + packager staging; default OFF
BUILD_MODE_ENABLED=false
KIMI_WORKBENCH_ENABLED=false
# WORKBENCH_SESSION_TIMEOUT_SECONDS=300
# WORKBENCH_NETWORK_ALLOWLIST=api.github.com,github.com

# Agentic coding CLI. Production Floor C-BRIEF dispatches ONE gated brief
# through this binary. If the coder is on and the binary is missing, the
# Floor fail-closes with FACTORY_CODE_CLI_UNAVAILABLE. If the binary is
# Kimi and ~/.kimi-code/config.toml is missing, it fail-closes with
# FACTORY_CODE_CLI_CREDENTIALS_MISSING. It will not claim "coding agent
# has taken over" or run an HTTP oneshot as a fake ≥2h session.
#   FACTORY_CODE_CLI=kimi      # Kimi CLI (default name; must be on PATH)
#   FACTORY_CODE_CLI=/abs/path # or an executable path
#   FACTORY_CODE_CLI=claude    # Claude Code CLI
# KIMI_CODE_CLI is still honoured; FACTORY_CODE_CLI wins.
# CLI auth is NOT CEREBRUM_LLM_API_KEY. Kimi Code reads ~/.kimi-code/config.toml
# (written at boot from KIMI_CODE_API_KEY when that secret is set). Boot also
# writes default_model so non-interactive kimi --prompt works without /login.
# KIMI_CODE_MODEL default is kimi-code/k3 (Kimi Code CLI 0.41). Owner-gated
# on Render — do not treat this file as proof the dashboard is set.
# FACTORY_BRIEF_HTTP_ONESHOT=1 is CI/dev only.
# FACTORY_CODE_CLI=kimi
# KIMI_CODE_CLI=kimi
# KIMI_CODE_API_KEY=
# KIMI_CODE_MODEL=kimi-code/k3
# KIMI_CODE_HOME=/app/.kimi-code
# FACTORY_BRIEF_HTTP_ONESHOT=0
# FACTORY_BRIEF_REQUIRE_CLI=1   # force generate-start refuse (CI mutation; production ENV already requires it)

# Optional Redis / Render Key Value for multi-worker session fan-out (not required for single instance)
# REDIS_URL=redis://localhost:6379/0
