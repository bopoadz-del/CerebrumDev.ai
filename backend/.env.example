CEREBRUM_API_URL=http://localhost:8000
# Copy from your vault (Bitwarden/1Password). No real keys in the repo.
CEREBRUM_API_KEY=

# Configurator backend API key. Required in production; optional in dev.
CEREBRUM_DEV_API_KEY=

# LLM provider: qwen | moonshot | ollama
# If unset, the app auto-detects from configured credentials.
LLM_PROVIDER=

# Qwen (DashScope) - OpenAI-compatible
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Moonshot AI - OpenAI-compatible
CEREBRUM_LLM_API_KEY=
CEREBRUM_LLM_BASE_URL=https://api.moonshot.cn/v1
CEREBRUM_LLM_MODEL=moonshot-v1-8k

# Ollama local or cloud
# Local:
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:32b

# Ollama Cloud:
# LLM_PROVIDER=ollama
# OLLAMA_URL=https://ollama.com
# OLLAMA_MODEL=kimi-k2.7-code:cloud
# OLLAMA_API_KEY=your_ollama_api_key

STORAGE_PATH=./storage
CHROMA_PERSIST_DIR=./storage/chroma

# Document parsing (local-only; disabled by default on Render)
MARKER_ENABLED=false  # set true only if marker-pdf is installed locally

# Fine-tuning (Tinker)
TINKER_API_KEY=
TINKER_BASE_MODEL=Qwen/Qwen2.5-7B-Instruct
TINKER_LORA_RANK=16
TINKER_BATCH_SIZE=4
TINKER_MAX_STEPS=10

# Tinker grounded adapter (inference)
GROUNDED_ADAPTER_ENABLED=false
GROUNDED_ADAPTER_REWRITE_PASS=false
GROUNDED_ADAPTER_TIMEOUT=60

# Auto-deploy Git auth.
# DEPLOY_REPO_URL is the dedicated target repository for git-push deploys.
# It must never be the CerebrumDev.ai repository itself. Git-push deploy is
# disabled when this variable is unset.
GITHUB_TOKEN=
DEPLOY_REPO_URL=

# Platform packager (P4): path to local Cerebrum-Blocks repo for kit resolution.
# Falls back to a sibling directory if not set.
CEREBRUM_BLOCKS_ROOT=

# Git repository used by the platform Dockerfile to clone the Cerebrum-Blocks runtime.
CEREBRUM_BLOCKS_REPO=https://github.com/bopoadz-del/Cerebrum-Blocks.git
