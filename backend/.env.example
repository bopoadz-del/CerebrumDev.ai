CEREBRUM_API_URL=http://localhost:8000
CEREBRUM_API_KEY=cb_dev_key

# LLM provider: Qwen (DashScope) OR Ollama (local/remote)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

OLLAMA_URL=
OLLAMA_MODEL=gpt-oss:120b-cloud

STORAGE_PATH=./storage
CHROMA_PERSIST_DIR=./storage/chroma

# Document parsing
MARKER_ENABLED=true  # set false to skip marker-pdf even when installed

# Fine-tuning (Tinker)
TINKER_API_KEY=
TINKER_BASE_MODEL=Qwen/Qwen2.5-7B-Instruct
TINKER_LORA_RANK=16
TINKER_BATCH_SIZE=4
TINKER_MAX_STEPS=10

# Tinker grounded adapter (inference)
GROUNDED_ADAPTER_ENABLED=false
GROUNDED_ADAPTER_REWRITE_PASS=false
GROUNDED_ADAPTER_TIMEOUT=60

# Auto-deploy Git auth
GITHUB_TOKEN=
GITHUB_USERNAME=bopoadz-del
DEPLOY_REPO=https://github.com/bopoadz-del/CerebrumDev.ai
