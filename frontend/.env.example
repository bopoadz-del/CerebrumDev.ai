# Backend API base URL (no trailing slash). In Vite dev, leave unset to use
# the same-origin /v1 proxy (frontend/vite.config.ts).
VITE_API_URL=http://localhost:8000
# Sentry (platform: javascript-react). Loaded lazily; inert when unset.
VITE_SENTRY_DSN=
# Do not set a master API key here. The SPA uses cdt_ login tokens from
# register/login. Baking CEREBRUM_DEV_API_KEY into VITE_* would publish it.
